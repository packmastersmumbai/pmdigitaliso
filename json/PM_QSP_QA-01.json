  "scope_cards": [
    {
      "label": "Purpose",
      "text": "To establish controls for creation, review, approval, distribution, revision, and disposal of documented information within the Integrated Management System."
    },
    {
      "label": "Scope",
      "text": "Applies to all IMS documents: policies, procedures, work instructions, forms, registers, plans, and external documents at Pack Masters."
    },
    {
      "label": "Responsible",
      "text": "Document Controller manages the document system. Authors draft documents. Quality Manager reviews. Approval Authority approves."
    }
  ],
  "flow_steps": [
    {
      "num": 1,
      "text": "Author drafts document using approved templates and coding convention",
      "critical": false,
      "callout": "PM/XXX/YY-NN format"
    },
    {
      "num": 2,
      "text": "Document Controller assigns document code and version number",
      "critical": true,
      "callout": ""
    },
    {
      "num": 3,
      "text": "Reviewer checks technical accuracy, compliance, and completeness",
      "critical": true,
      "callout": ""
    },
    {
      "num": 4,
      "text": "Approver authorises document for release",
      "critical": true,
      "callout": ""
    },
    {
      "num": 5,
      "text": "Document Controller distributes controlled copies and updates Master List",
      "critical": true,
      "callout": ""
    },
    {
      "num": 6,
      "text": "Obsolete versions withdrawn and marked 'OBSOLETE'",
      "critical": true,
      "callout": ""
    },
    {
      "num": 7,
      "text": "External documents identified, registered, and controlled",
      "critical": false,
      "callout": ""
    },
    {
      "num": 8,
      "text": "Records retained per retention schedule, disposed securely after expiry",
      "critical": false,
      "callout": ""
    }
  ],
  "procedure": [
    {
      "num": 1,
      "phase": "Creation",
      "activity": "Author drafts document using standard template. Include purpose, scope, procedure, records, references",
      "responsible": "Document Author",
      "critical": false,
      "record": "Draft Document"
    },
    {
      "num": 2,
      "phase": "Coding",
      "activity": "Assign document code per convention: PM/[Type]/[Dept]-[Seq]. Assign version 1.0 for new documents",
      "responsible": "Document Controller",
      "critical": true,
      "record": "Master List"
    },
    {
      "num": 3,
      "phase": "Review",
      "activity": "Technical review by subject matter expert. Check compliance with ISO requirements and company standards",
      "responsible": "Quality Manager",
      "critical": true,
      "record": "Review Comments"
    },
    {
      "num": 4,
      "phase": "Approval",
      "activity": "Final approval by designated authority. Electronic or wet signature on approval record",
      "responsible": "Approval Authority",
      "critical": true,
      "record": "Approval Record"
    },
    {
      "num": 5,
      "phase": "Distribution",
      "activity": "Distribute controlled copies (electronic preferred). Update Master Document List. Notify users of new/revised documents",
      "responsible": "Document Controller",
      "critical": true,
      "record": "Distribution Record"
    },
    {
      "num": 6,
      "phase": "Revision",
      "activity": "Revisions follow same review-approve cycle. Increment version. Document changes in revision history",
      "responsible": "Document Controller",
      "critical": true,
      "record": "Revision History"
    },
    {
      "num": 7,
      "phase": "Obsolescence",
      "activity": "Withdraw obsolete versions. Stamp/mark as 'OBSOLETE'. Retain one archived copy per retention policy",
      "responsible": "Document Controller",
      "critical": true,
      "record": "Withdrawal Record"
    },
    {
      "num": 8,
      "phase": "Retention",
      "activity": "Retain records per retention schedule (minimum 3 years). Dispose securely (shred/delete) after expiry",
      "responsible": "Document Controller",
      "critical": false,
      "record": "Disposal Record"
    }
  ],
