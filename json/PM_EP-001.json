 "scope_cards": [
  {
   "label": "Purpose",
   "text": "To identify and evaluate environmental aspects and impacts arising from Pack Masters operations, and to determine significance for control and improvement."
  },
  {
   "label": "Scope",
   "text": "All activities at Pack Masters including production (downfilling, labelling, lid pressing), storage of chemicals (acetone, adhesives), waste generation, and energy consumption."
  },
  {
   "label": "Responsible",
   "text": "Environment Coordinator, Ms. Khushi Paswan (QMR), Department Heads"
  }
 ],
 "risks": [
  {
   "id": "EA-001",
   "category": "Air Emissions",
   "description": "VOC emissions from adhesive and acetone handling during downfilling and storage operations",
   "likelihood": 3,
   "impact": 4,
   "controls": "Local exhaust ventilation (LEV), closed barrel storage, LEL monitors, vapour return lines on auto-filling machines",
   "owner": "Environment Coordinator"
  },
  {
   "id": "EA-002",
   "category": "Waste Generation",
   "description": "Hazardous waste from acetone-contaminated absorbent pads, rags, and expired chemicals",
   "likelihood": 3,
   "impact": 4,
   "controls": "Segregated hazardous waste storage, disposal through authorised TSDF (Category 34.3), manifest tracking",
   "owner": "Store In-Charge"
  },
  {
   "id": "EA-003",
   "category": "Water Pollution",
   "description": "Potential acetone or adhesive spill reaching drainage or soil",
   "likelihood": 2,
   "impact": 5,
   "controls": "110% bund around storage, spill kits at all handling areas, no drain discharge policy, absorbent pads (never sawdust)",
   "owner": "Safety Officer"
  },
  {
   "id": "EA-004",
   "category": "Solid Waste",
   "description": "Packaging waste — corrugated boxes, BOPP tape, damaged tins, obsolete labels",
   "likelihood": 4,
   "impact": 2,
   "controls": "Waste segregation at source, recycling of corrugated and metal, label destruction and mass balance tracking",
   "owner": "Production Supervisor"
  },
  {
   "id": "EA-005",
   "category": "Energy Use",
   "description": "Electricity consumption for filling machines, lid press, lighting, and ventilation systems",
   "likelihood": 3,
   "impact": 2,
   "controls": "Equipment shutdown after shifts (SOP/PD-01 Step 3.23), energy monitoring per PM/QSP/ENV-03",
   "owner": "Maintenance"
  },
  {
   "id": "EA-006",
   "category": "Chemical Storage",
   "description": "Risk of fire or explosion from improper acetone storage conditions",
   "likelihood": 2,
   "impact": 5,
   "controls": "Approved flammable liquid storage (<30C), flameproof fittings, fire extinguishers (CO2/DCP/AR-AFFF), SOP/PD-05 compliance",
   "owner": "Store In-Charge"
  },
  {
   "id": "EA-007",
   "category": "Noise",
   "description": "Noise from pneumatic lid press, sealing machines, and stirrer motors",
   "likelihood": 3,
   "impact": 2,
   "controls": "Ear protection PPE, periodic noise level monitoring, equipment maintenance schedule",
   "owner": "Safety Officer"
  },
  {
   "id": "EA-008",
   "category": "Resource Use",
   "description": "Consumption of raw materials — adhesives, solvents, tins, labels, corrugated boxes",
   "likelihood": 3,
   "impact": 2,
   "controls": "Yield monitoring (PM/QSP/QA-11), scrap review (PM/QSP/QA-12), production sheet material balance",
   "owner": "Production Supervisor"
  }
 ],
