 "extra_css": "\n/* Hierarchy at 6-7pt: the department has to win the squint test, so it is set\n   1.5x the supporting text rather than the 1.29x it was — below that ratio the\n   three lines read as one grey block. The position code carries contrast\n   instead of size: a filled chip is legible at 5.2pt where a larger grey\n   number is not. */\n.oc{padding:14px 0 6px}\n.oc-lvl{display:flex;justify-content:center}\n/* A floor on the width: below about 88px the department name breaks one word\n   per line and the box becomes a vertical strip. Wrapping the row is the\n   better failure — it stays readable. */\n.oc-box{border:1px solid var(--ln2);border-radius:4px;background:#fff;\n        text-align:center;padding:8px 7px 7px;width:100%;min-width:86px;\n        max-width:132px;line-height:1.15;hyphens:auto}\n.oc-box .p{display:inline-block;font-family:ui-monospace,Consolas,monospace;\n           font-size:5.2pt;font-weight:700;letter-spacing:.1em;\n           background:var(--ln2);color:#fff;border-radius:2px;\n           padding:1px 5px 0;margin-bottom:5px}\n.oc-box .d{display:block;font-size:8.6pt;font-weight:750;color:var(--ink);\n           letter-spacing:-.01em}\n.oc-box .r{display:block;font-size:5.4pt;color:var(--mut);margin-top:4px;\n           text-transform:uppercase;letter-spacing:.07em}\n.oc-1{background:var(--ac);border-color:var(--ac);max-width:168px}\n.oc-1 .p{background:rgba(255,255,255,.28);color:#fff}\n.oc-1 .d{color:#fff;font-size:9.4pt}\n.oc-1 .r{color:rgba(255,255,255,.85)}\n.oc-2{border-color:var(--ac);border-width:1.5px;background:var(--tint);\n      max-width:150px}\n.oc-2 .p{background:var(--ac)}\n.oc-2 .d{font-size:9pt;color:var(--ac)}\n.oc-stem{width:1px;height:14px;background:var(--ln2);margin:0 auto}\n.oc-bar{height:1px;background:var(--ln2);margin:0 auto;width:90%}\n.oc-kids{display:flex;justify-content:center;align-items:flex-start;\n         gap:7px;flex-wrap:wrap;row-gap:12px}\n.oc-kid{display:flex;flex-direction:column;align-items:center;\n        flex:1 1 86px;min-width:86px}\n.oc-cap{font-size:5.4pt;color:var(--mut);text-align:center;margin-top:10px;\n        letter-spacing:.02em}\n@media print{\n  .oc-box{background:#fff!important}\n  .oc-box .p{-webkit-print-color-adjust:exact;print-color-adjust:exact}\n  .oc-1,.oc-2{-webkit-print-color-adjust:exact;print-color-adjust:exact}\n  .oc-1{background:var(--ac)!important}\n  .oc-2{background:var(--tint)!important}\n}\n",
